/* The app's own colors, the same in every terminal (theme.py has them too; keep them in step): light text on a dark
   ground, gray structure, the brand's teal-gray behind what's picked, color for meaning only. Dialogs are a lighter
   panel over the page, so they stand apart; what sits inside them is transparent, so the panel shows through. */
$ground: #1e2425;
$text-main: #d9dfdf;
$text-muted: #8c999a;
$line: #4b5657;
$line-focus: #8c999a;
$brand: #364445;
$accent-color: #8fc4cf;
$user-color: #9ccfae;
$warning-color: #e3bd6b;
$error-color: #e8806f;
$dialog-background: #283031;

Screen {
    layout: vertical;
    background: $ground;
    color: $text-main;
}

#body {
    height: 1fr;
}

#chat-column {
    width: 1fr;
}

#main {
    height: 1fr;
}

/* The navigation on the left of the chat and of every page; collapsed (F4), each page's glyph. Its lines are one
   each, cut to its width: an open conversation's title can be long. */
Sidebar {
    width: 26;
    height: 1fr;
    padding: 0 1;
    border: none;
    border-right: solid $line;
    background: transparent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Sidebar:focus {
    border: none;
    border-right: solid $line;
}

Sidebar.collapsed {
    width: 5;
}

/* A page fills the room beside the sidebar: what was a dialog's panel (its border, width and background) gives way. */
#page-row {
    height: 1fr;
}

#page-body {
    width: 1fr;
    height: 1fr;
}

#page-row > #page-body > * {
    width: 1fr;
    height: 1fr;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    border: none;
    background: transparent;
    padding: 1 2;
}

/* Settings: a tab per section along the top, the section shown under it filling the rest of the page as a page's
   content does; its panel (border, width, background) gives way too. */
#page-row > #page-body > #settings-tabs {
    padding: 0 1;
}

#settings-tabs > ContentSwitcher, #settings-tabs TabPane, #settings-tabs SettingsSection {
    height: 1fr;
    padding: 0;
}

#page-body #settings-tabs SettingsSection > * {
    width: 1fr;
    max-width: 100%;
    margin: 0;
    border: none;
    background: transparent;
    padding: 1 1 0 1;
}

#page-body #settings-tabs TabPane > SettingsSection > * {
    height: 1fr;
    max-height: 100%;
}

/* A tab of several sections shows them in one scroll as the web app's cards, in its two columns, or one above the
   other when the tab is too narrow for two (screens/settings.py); each as tall as what it shows and framed in the
   focus color while something in it has the focus. The cards' own Close buttons give way to the tab's one under them. */
#page-body #settings-tabs .settings-stack Vertical, #page-body #settings-tabs .settings-stack VerticalScroll, #page-body #settings-tabs .settings-stack Horizontal {
    height: auto;
}

/* A list beside its detail among the cards (Kept keys, the skills), as tall as a few to pick from; the list and the
   detail scroll past them. */
#page-body #settings-tabs .settings-stack #keys-main {
    height: 12;
}

#page-body #settings-tabs .settings-stack #skills-main {
    height: 16;
}

#page-body #settings-tabs .settings-stack #keys-detail, #page-body #settings-tabs .settings-stack #skills-detail {
    height: 1fr;
}

#page-body #settings-tabs .settings-column {
    width: 1fr;
}

#page-body #settings-tabs .settings-column:first-child {
    margin-right: 1;
}

#page-body #settings-tabs .settings-column:last-child {
    margin-right: 0;
}

#page-body #settings-tabs .settings-columns.-one-column {
    layout: vertical;
}

#page-body #settings-tabs .settings-columns.-one-column .settings-column {
    margin-right: 0;
}

#page-body #settings-tabs .settings-stack {
    padding: 1 1 0 0;
}

#page-body #settings-tabs .settings-stack SettingsSection {
    border: round $line;
    padding: 0 1;
    margin-bottom: 1;
}

#page-body #settings-tabs .settings-stack SettingsSection:focus-within {
    border: round $line-focus;
}

/* A section alone in its tab where the web app shows it as a card (the system prompt, the clients): the editor fills
   the tab, the clients' table is as tall as it is. */
#page-body #settings-tabs SettingsSection.settings-card {
    border: round $line;
    margin-top: 1;
}

#page-body #settings-tabs #settings-section-sessions, #page-body #settings-tabs #settings-section-sessions > #sessions {
    height: auto;
    max-height: 100%;
}

#page-body #settings-tabs SettingsSection.settings-card:focus-within {
    border: round $line-focus;
}

#page-body #settings-tabs .settings-stack SettingsSection > * {
    padding: 0;
}

#settings-tabs .settings-stack SettingsSection #close {
    display: none;
}

/* What doesn't fit in one row of a card in a column: the assistant's buttons two a row, and the confidence's box
   taking the room its label and button leave. */
#page-body #settings-tabs .settings-stack #host-buttons {
    layout: grid;
    grid-size: 2;
    grid-rows: 3;
    grid-gutter: 1 0;
}

#page-body #settings-tabs .settings-stack #model-dispatch Input {
    width: 1fr;
}

#page-body #settings-tabs .settings-stack-buttons {
    height: auto;
    margin-bottom: 1;
}

/* The tabs: muted, the one shown in the main text with the accent under it; while they have the focus, it's picked as
   in every list. */
#settings-tabs Tab {
    color: $text-muted;
}

#settings-tabs Tab:hover, #settings-tabs Tab.-active {
    color: $text-main;
}

#settings-tabs Underline > .underline--bar {
    color: $accent-color;
    background: $line;
}

#chat {
    width: 1fr;
    padding: 0 1;
}

UserMessage {
    color: $user-color;
    margin: 1 0 0 0;
}

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0 0 0 1;
    background: transparent;
    border-left: outer $line;
}

/* Markdown blocks keep a blank line below them; the reply's last one doesn't need it. */
AssistantMessage > MarkdownBlock:last-child {
    margin-bottom: 0;
}

AssistantMessage MarkdownParagraph, AssistantMessage MarkdownBullet, AssistantMessage MarkdownListItem {
    color: $text-main;
}

TranscriptNote, ToolNote, StoppedNote, ChoicesNote {
    color: $text-muted;
    padding: 0 0 0 2;
}

SystemNote {
    margin: 1 0 0 0;
    padding: 0 1;
    background: transparent;
    border: round $line;
}

ErrorMessage {
    color: $error-color;
    margin: 1 0 0 0;
}

ToolCall {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
}

ThinkingNote {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    text-style: italic;
}

ThinkingNote .thinking-text {
    padding: 0 0 0 2;
}

.follow-up-note {
    margin: 1 0 0 0;
    color: $text-muted;
}

CarriedNote, BriefNote {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
}

CarriedNote .carried-text, BriefNote .brief-text {
    padding: 0 0 0 2;
    background: transparent;
}

ToolCall .tool-result {
    color: $text-muted;
    padding: 0 0 0 2;
}

ConnectionNote {
    height: 1;
    padding: 0 1;
    color: $warning-color;
}

StatusLine {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
}

CommandMenu {
    display: none;
    height: auto;
    max-height: 10;
    padding: 0 1;
    color: $text-main;
}

.command-row {
    width: 100%;
    height: 1;
}

.command-row.highlighted {
    /* What's picked, as in every list. */
    background: $brand;
    color: $text-main;
}

CommandMenu.visible {
    display: block;
}

#footer-row {
    dock: bottom;
    height: 1;
}

#footer-row Footer {
    dock: none;
    width: 1fr;
}

ContextFuel {
    width: auto;
    padding: 0 1;
}

MouseStatus {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#prompt-box {
    height: auto;
    border: round $line;
}

#prompt-box:focus-within {
    border: round $line-focus;
}

/* Inside the box's border, so the message box itself has none. */
#prompt, #prompt:focus {
    border: none;
    height: 1;
    width: 1fr;
}

AttachmentBar {
    display: none;
    width: auto;
    height: 1;
    padding-left: 1;
}

AttachmentBar.visible {
    display: block;
}

AttachmentBar .tag {
    width: auto;
    margin-right: 1;
    color: $text-muted;
    text-style: bold;
}

EmailScreen, ChannelSetupScreen, McpAddScreen, McpSecretsScreen, SkillEditScreen {
    align: center middle;
}

#about-you, #suggested-plugins, #profile, #web-search, #email, #email-recipients, #home-section, #channel-setup-dialog, #startup, #host, #mcp-add, #mcp-secrets-dialog, #mcp-sign-in, #plugin-sign-in, #open-conversations, #model, #audio, #skill-edit, #repository-install, #plugin-settings, #update-values, #spending {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round $line;
    background: $dialog-background;
}

#about-you Markdown, #suggested-plugins Markdown, #profile Markdown, #web-search Markdown, #home-section Markdown, #email Markdown, #email-recipients Markdown, #channel-setup-dialog Markdown, #startup Markdown, #host Markdown, #mcp-add Markdown, #mcp-secrets-dialog Markdown, #mcp-sign-in Markdown, #plugin-sign-in Markdown, #model Markdown, #audio Markdown, #spoken Markdown, #skill-edit Markdown, #repository-install Markdown, #plugin-settings Markdown, #update-values Markdown, #spending Markdown {
    background: transparent;
    margin: 0;
}

/* Dialogs already have top padding; a heading's default top margin would add two more empty rows. */
ModalScreen Markdown > MarkdownHeader:first-child, PageScreen Markdown > MarkdownHeader:first-child {
    margin-top: 0;
}

#about-you-buttons, #suggested-plugins-buttons, #profile-buttons, #web-search-buttons, #home-section-buttons, #email-buttons, #email-recipients-buttons, #channel-setup-buttons, #startup-buttons, #host-buttons, #mcp-add-buttons, #mcp-secrets-buttons, #mcp-sign-in-buttons, #plugin-sign-in-buttons, #open-conversations-buttons, #model-buttons, #audio-buttons, #skill-edit-buttons, #repository-buttons, #plugin-settings-buttons, #update-values-buttons, #spending-buttons {
    height: auto;
    margin-top: 1;
}

#about-you-buttons Button, #suggested-plugins-buttons Button, #profile-buttons Button, #web-search-buttons Button, #home-section-buttons Button, #email-buttons Button, #email-recipients-buttons Button, #channel-setup-buttons Button, #startup-buttons Button, #host-buttons Button, #mcp-add-buttons Button, #mcp-secrets-buttons Button, #mcp-sign-in-buttons Button, #plugin-sign-in-buttons Button, #open-conversations-buttons Button, #model-buttons Button, #audio-buttons Button, #skill-edit-buttons Button, #repository-buttons Button, #plugin-settings-buttons Button, #update-values-buttons Button, #spending-buttons Button {
    margin-right: 2;
}

/* The About you step: a label above each answer, the topics and the plugins it suggests in lists of their height. */
.about-you-label {
    margin-top: 1;
    text-style: bold;
}

#about-you-help, #suggested-plugins-list {
    height: auto;
    max-height: 14;
}

/* Sending messages on from Chat, under the model in /model. */
#model-dispatch {
    height: auto;
    margin-top: 1;
}

#model-dispatch Label {
    padding: 1 1 0 0;
}

#model-dispatch Input {
    width: 24;
}

/* Each spending limit in /limits: its label, then its amount. */
.spending-limit {
    height: auto;
}

.spending-limit Label {
    width: 1fr;
    padding: 1 1 0 0;
}

.spending-limit Input {
    width: 16;
}

/* A channel's setup in /plugins, drawn from the items it sends. */
#plugin-setup, .channel-setup {
    height: auto;
}

.channel-setup Static {
    margin-bottom: 1;
}

.channel-setup .channel-heading {
    text-style: bold;
    margin-top: 1;
}

.channel-setup .channel-code {
    color: $accent;
}

.channel-setup .channel-qr {
    width: auto;
    height: auto;
}

.channel-setup .channel-copy {
    height: 8;
    border: round $line;
    background: transparent;
}

.channel-setup .channel-actions {
    height: auto;
    margin-bottom: 1;
}

.channel-setup .channel-actions Button {
    margin-right: 2;
}

ApprovalScreen {
    align: center middle;
}

#approval {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round $warning-color;
    background: $dialog-background;
}

#approval-call {
    margin: 1 0 0 0;
    padding: 0 1;
}

#approval-command {
    margin: 1 0;
    padding: 0 1;
    background: transparent;
    color: $warning-color;
}

#approval-buttons {
    height: auto;
    margin-top: 1;
}

#approval-buttons Button {
    margin-right: 2;
}

QuestionScreen, FormScreen, PluginUpdatesScreen, AgentFolderScreen {
    align: center middle;
}

#question, #form, #plugin-updates, #agent-folder, #repositories, #skill-imports {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round $accent-color;
    background: $dialog-background;
}

#question-options, #plugin-updates-list, #agent-folder-options, #repositories-list, #skill-imports-list {
    height: auto;
    max-height: 14;
    margin: 1 0;
}

#skill-imports-title {
    text-style: bold;
}

#question-buttons, #plugin-updates-buttons, #agent-folder-buttons, #repositories-buttons, #skill-imports-buttons {
    height: auto;
}

#question-buttons Button, #plugin-updates-buttons Button, #repositories-buttons Button, #skill-imports-buttons Button {
    margin-right: 2;
}

SideConversationScreen {
    align: center middle;
}

#side-conversation {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round $accent-color;
    background: $dialog-background;
}

#side-conversation-brief {
    margin: 1 0;
}

#side-conversation-buttons {
    height: auto;
}

#side-conversation-buttons Button {
    margin-right: 2;
}

ConfirmScreen {
    align: center middle;
}

#confirm {
    width: 60%;
    max-width: 70;
    height: auto;
    padding: 1 2;
    border: round $error-color;
    background: $dialog-background;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-right: 2;
}

Toast {
    background: $dialog-background;
    color: $text-main;
    border: round $line;
    padding: 0 1;
    max-width: 60;
}

Toast.-warning {
    border: round $warning-color;
}

Toast.-error {
    border: round $error-color;
}

/* Markdown everywhere: default text color, dim structure, no colored inline code or headings. */
Markdown {
    color: $text-main;
}

MarkdownH1, MarkdownH2, MarkdownH3 {
    content-align: left middle;
}

MarkdownBullet {
    color: $text-muted;
}

Markdown MarkdownBlock > .code_inline {
    color: $text-main !important;
    background: transparent !important;
    text-style: bold;
}

/* Buttons: gray outline, bold when focused; red text only for destructive actions. */
Button {
    background: transparent;
    color: $text-main;
    border: round $line;
    text-style: none;
}

Button:focus {
    border: round $line-focus;
    text-style: bold;
}

Button:hover {
    background: transparent;
    border: round $line-focus;
}

Button.-success, Button.-primary {
    background: transparent;
    color: $text-main;
}

Button.-error {
    background: transparent;
    color: $error-color;
}

/* A compact button is one line in a bar of them: no border, so the focus shows on its label. */
Button.-textual-compact, Button.-textual-compact:hover {
    border: none;
    height: 1;
    color: $accent-color;
}

Button.-textual-compact:focus {
    border: none;
    text-style: bold underline;
}

ModalScreen Input, ModalScreen OptionList, ModalScreen MarkdownHeader, PageScreen Input, PageScreen OptionList, PageScreen MarkdownHeader {
    background: transparent;
}

#profile Input, #profile SelectCurrent, #web-search Input, #home-section Input, #email Input, #email SelectCurrent, #mcp-add Input, #mcp-add SelectCurrent, #mcp-sign-in Input, #plugin-sign-in Input, #model Input, #model SelectCurrent, #audio SelectCurrent, #skill-edit Input, #repository-install Input, #plugin-settings Input, #update-values Input, #spending Input, #briefing Input, #briefing SelectCurrent, #briefing Switch {
    border: round $line;
    background: transparent;
}

#profile Input:focus, #web-search Input:focus, #home-section Input:focus, #email Input:focus, #mcp-add Input:focus, #mcp-sign-in Input:focus, #plugin-sign-in Input:focus, #model Input:focus, #skill-edit Input:focus, #repository-install Input:focus, #plugin-settings Input:focus, #update-values Input:focus, #spending Input:focus, #briefing Input:focus, #briefing Switch:focus, #briefing Select:focus > SelectCurrent {
    border: round $line-focus;
}

JobsScreen, ConversationsScreen, DevicesScreen, HomeScreen, UsageScreen, NotificationsScreen, SubagentsScreen {
    align: center middle;
}

#skills, #jobs, #conversations, #devices, #keys, #home, #doctor, #briefing, #files, #usage, #sessions, #mcp, #plugins, #logs, #notifications, #prompts, #subagents, #alerts {
    width: 90%;
    max-width: 120;
    height: 80%;
    padding: 1 2;
    border: round $line;
    background: $dialog-background;
}

#skills Markdown, #jobs Markdown, #conversations Markdown, #devices Markdown, #keys Markdown, #home Markdown, #doctor Markdown, #briefing Markdown, #files Markdown, #usage Markdown, #sessions Markdown, #mcp Markdown, #plugins Markdown, #notifications Markdown, #alerts Markdown {
    background: transparent;
    margin: 0;
}

#skills-title, #jobs-title, #conversations-title, #devices-title, #keys-title, #home-title, #doctor-title, #briefing-title, #files-title, #mcp-title, #plugins-title, #notifications-title, #prompts-title, #open-conversations-title, #subagents-title, #alerts-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#skills-empty, #jobs-empty, #conversations-empty, #mcp-empty, #plugins-empty, #notifications-empty, #open-conversations-empty, #subagents-empty, #alerts-empty {
    display: none;
    height: auto;
}

#skills.empty, #jobs.empty, #conversations.empty, #mcp.empty, #plugins.empty, #notifications.empty, #open-conversations.empty, #subagents.empty, #alerts.empty {
    height: auto;
}

#skills.empty #skills-main, #jobs.empty #jobs-main, #conversations.empty #conversations-main, #mcp.empty #mcp-main, #plugins.empty #plugins-main, #notifications.empty #notifications-main, #open-conversations.empty #open-conversations-list, #subagents.empty #subagents-main, #alerts.empty #alerts-main {
    display: none;
}

#skills.empty #skills-empty, #jobs.empty #jobs-empty, #conversations.empty #conversations-empty, #mcp.empty #mcp-empty, #plugins.empty #plugins-empty, #notifications.empty #notifications-empty, #open-conversations.empty #open-conversations-empty, #subagents.empty #subagents-empty, #alerts.empty #alerts-empty {
    display: block;
}

#skills-main, #jobs-main, #conversations-main, #devices-main, #keys-main, #home-main, #doctor-main, #briefing-main, #files-main, #mcp-main, #usage-scroll, #plugins-main, #prompts-main, #subagents-main, #notifications-main, #alerts-main {
    height: 1fr;
}

/* A short list: the dialog fits its content. */
#sessions {
    height: auto;
    max-height: 80%;
}

#sessions-scroll {
    height: auto;
}

#skills-list, #jobs-list, #conversations-list, #devices-list, #keys-list, #home-list, #doctor-list, #briefing-list, #files-list, #plugins-list {
    width: 36;
    border: round $line;
    background: transparent;
}

/* A list inside a card (Kept keys, the skills, the system prompt) has no frame of its own; a divider sets it apart
   from the detail next to it. The pages' lists are cards of their own (below). */
#keys-list, #skills-list, #prompts-list {
    border: none;
}

/* Listed only by when, on one line: "Wed 30 Sep 09:00". */
#conversations-list, #notifications-list, #alerts-list {
    width: 20;
}

/* Each one's status, time and task. */
#subagents-list {
    width: 48;
    background: transparent;
}

#jobs-list, #devices-list, #keys-list, #home-list, #doctor-list, #briefing-list, #files-list, #skills-list, #mcp-list, #plugins-list, #prompts-list {
    width: 32;
}

/* "Last active" is underlined across the preview, separating it from what was said. A Markdown
   rule would leave an empty line above itself. */
#conversation-body > MarkdownParagraph:first-of-type {
    border-bottom: solid $line;
}

#conversations-main .divider, #jobs-main .divider, #devices-main .divider, #keys-main .divider, #home-main .divider, #doctor-main .divider, #briefing-main .divider, #files-main .divider, #skills-main .divider, #mcp-main .divider, #plugins-main .divider, #prompts-main .divider, #subagents-main .divider, #notifications-main .divider, #alerts-main .divider {
    width: 1;
    height: 1fr;
    margin: 1 1 1 0;
    border-left: solid $line;
}

#skills-detail, #jobs-detail, #conversations-detail, #devices-detail, #keys-detail, #home-detail, #doctor-detail, #briefing-detail, #files-detail, #mcp-detail, #plugins-detail, #prompts-detail, #subagents-detail, #notifications-detail, #alerts-detail {
    padding: 0 1;
}

/* The pages' lists as the web app's: the list in a card beside the card of the entry picked (its table and details
   cards) in place of the divider, each framed in the focus color while it has the focus. Inside a card already (Kept
   keys, the skills, the system prompt) the divider stays. */
#conversations-list, #jobs-list, #devices-list, #home-list, #doctor-list, #files-list, #mcp-list, #plugins-list, #subagents-list, #notifications-list, #alerts-list, #conversations-detail, #jobs-detail, #devices-detail, #home-detail, #doctor-detail, #files-detail, #mcp-detail, #plugins-detail, #subagents-detail, #notifications-detail, #alerts-detail {
    border: round $line;
}

#conversations-list:focus, #jobs-list:focus, #devices-list:focus, #home-list:focus, #doctor-list:focus, #files-list:focus, #mcp-list:focus, #plugins-list:focus, #subagents-list:focus, #notifications-list:focus, #alerts-list:focus, #conversations-detail:focus-within, #jobs-detail:focus-within, #devices-detail:focus-within, #home-detail:focus-within, #doctor-detail:focus-within, #files-detail:focus-within, #mcp-detail:focus-within, #plugins-detail:focus-within, #subagents-detail:focus-within, #notifications-detail:focus-within, #alerts-detail:focus-within {
    border: round $line-focus;
}

#conversations-list, #jobs-list, #devices-list, #home-list, #doctor-list, #files-list, #mcp-list, #plugins-list, #subagents-list, #notifications-list, #alerts-list {
    height: 1fr;
    margin-right: 1;
}

#conversations-main .divider, #jobs-main .divider, #devices-main .divider, #home-main .divider, #doctor-main .divider, #files-main .divider, #mcp-main .divider, #plugins-main .divider, #subagents-main .divider, #notifications-main .divider, #alerts-main .divider {
    display: none;
}

/* Usage's report, a card as the web app's. */
#usage-scroll {
    border: round $line;
    padding: 0 1;
}

#usage-scroll:focus-within {
    border: round $line-focus;
}

#skills-buttons, #jobs-buttons, #conversations-buttons, #devices-buttons, #keys-buttons, #home-buttons, #doctor-buttons, #briefing-buttons, #files-buttons, #usage-buttons, #sessions-buttons, #mcp-buttons, #plugins-buttons, #notifications-buttons, #prompts-buttons, #subagents-buttons, #alerts-buttons {
    height: auto;
    margin-top: 1;
}

#skills-buttons Button, #jobs-buttons Button, #conversations-buttons Button, #devices-buttons Button, #keys-buttons Button, #home-buttons Button, #doctor-buttons Button, #briefing-buttons Button, #files-buttons Button, #usage-buttons Button, #mcp-buttons Button, #plugins-buttons Button, #notifications-buttons Button, #prompts-buttons Button, #subagents-buttons Button, #alerts-buttons Button {
    margin-right: 2;
}

/* Scrollbars in gray, like the rest of the structure. */
* {
    scrollbar-color: $text-muted;
    scrollbar-color-hover: $line-focus;
    scrollbar-color-active: $line-focus;
    scrollbar-background: $ground;
    scrollbar-background-hover: $ground;
    scrollbar-background-active: $ground;
    scrollbar-corner-color: $ground;
}

#mcp-tools, #mcp-add-tools, #repository-found {
    height: auto;
    max-height: 16;
    background: transparent;
}

#mcp-secrets, #mcp-secrets-text {
    height: 6;
}

#mcp-add, #repository-install, #plugin-settings, #update-values {
    max-height: 90%;
}

#repository-fields, #plugin-settings-fields, #update-values-fields {
    height: auto;
}

.plugin-settings-label {
    margin-top: 1;
    text-style: bold;
}

.audio-note {
    color: $text-muted;
}

.audio-buttons {
    height: auto;
    margin-top: 1;
}

.audio-buttons Button {
    margin-right: 2;
}

#audio-languages {
    height: auto;
    max-height: 10;
    background: transparent;
}


#skill-edit-title {
    text-style: bold;
    margin-bottom: 1;
}

#skill-edit-instructions {
    height: 16;
}

#model-fields {
    height: auto;
}

#plugins-search, #conversations-search {
    margin: 0 0 1 0;
    border: round $line;
    background: transparent;
}

#plugins-search:focus, #conversations-search:focus {
    border: round $line-focus;
}

/* When the plugins were last checked, then the buttons for all of them, on one line. */
#plugins-bar {
    height: 1;
    margin-bottom: 1;
}

#plugins-checked {
    width: 1fr;
}

#plugins-bar Button {
    margin-left: 2;
}

#conversations.empty #conversations-search {
    display: none;
}

#profile-items {
    height: auto;
    max-height: 12;
    margin: 1 0;
    border: round $line;
    background: transparent;
}

/* /logs: filters on top, the log in the middle, its controls below. */
#logs-filters, #logs-buttons {
    height: auto;
}

#logs-filters Select {
    width: 1fr;
    margin-right: 1;
}

#logs SelectCurrent {
    border: round $line;
    background: transparent;
}

#logs-title {
    height: auto;
    text-style: bold;
    margin: 1 0 0 0;
}

#logs-body {
    height: 1fr;
    background: transparent;
    border: round $line;
}

#logs-buttons {
    margin-top: 1;
}

#logs-buttons Button {
    margin-right: 2;
}

#logs-follow-label, #logs-record-label {
    height: 3;
    content-align: center middle;
    margin-right: 1;
}

#logs-follow {
    margin-right: 2;
}

#logs-record {
    width: 26;
    margin-right: 2;
}

/* What the text is for over the text, which takes the rest. */
#prompt-about {
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}

#prompt-text {
    height: 1fr;
}

/* What a Home section shows: room for the assistant's instructions, then its plugins. */
#home-section-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#home-section-prompt {
    height: 8;
}

/* A section built by code: what it shows, which only the code changes. */
#home-section-shows {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#home-section-note {
    height: auto;
    margin-top: 1;
}

#home-section-plugins {
    height: auto;
    max-height: 8;
    background: transparent;
}

/* Home's buttons are many: they keep closer together than other screens'. */
#home-buttons Button {
    margin-right: 1;
    min-width: 8;
}

/* How the built-in text changed since an edit: a few lines of diff above the editor. */
#prompt-changes {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    margin-bottom: 1;
    color: $warning;
}

#open-conversations-list {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}

/* /folder: the tree, with what changed above it, beside the file picked. */
#folder {
    width: 95%;
    max-width: 160;
    height: 90%;
    padding: 1 2;
    border: round $line;
    background: $dialog-background;
}

#folder-title, #folder-file-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#folder-main {
    height: 1fr;
}

#folder-side {
    width: 40;
    border-right: solid $line;
    padding-right: 1;
}

#folder-changed-title {
    height: auto;
    color: $text-muted;
}

#folder-changes {
    height: auto;
    max-height: 8;
    border: none;
    background: transparent;
    margin-bottom: 1;
}

#folder-tree {
    height: 1fr;
    background: transparent;
}

#folder-view {
    padding: 0 1;
}

#folder-file {
    width: auto;
}

#folder-buttons {
    height: auto;
    margin-top: 1;
}

#folder-buttons Button, #folder-buttons Checkbox {
    margin-right: 2;
}

#form-message, #form-url {
    margin: 1 0;
}

#form-url {
    color: $accent-color;
}

#form-fields {
    height: auto;
    max-height: 20;
}

#form-fields .form-title {
    margin-top: 1;
    text-style: bold;
}

#form-buttons {
    height: auto;
    margin-top: 1;
}

#form-buttons Button {
    margin-right: 2;
}

/* The briefing's settings: what they are, a switch beside each feature, the times and the weekly day under them. */
#briefing-settings {
    height: auto;
}
#briefing-intro {
    width: 1fr;
    margin-bottom: 1;
}
.briefing-row {
    height: auto;
    margin-bottom: 1;
}
.briefing-row Label {
    padding: 1 0 0 1;
}
#briefing-muted {
    height: auto;
    margin-top: 1;
}
.briefing-muted-title {
    text-style: bold;
}
.briefing-muted-row {
    height: auto;
}
.briefing-muted-row Label {
    width: 1fr;
    padding: 1 0 0 0;
}

/* A section of one plugin that lists its day: whether the model builds it instead. */
#home-section-model {
    height: auto;
}
#home-section-model Label {
    padding: 1 0 0 1;
}
#home-section-model-note {
    height: auto;
    color: $text-muted;
}

/* Simple line border for every form control (Textual's default "tall" border shows as stray dashes). */
Input, Switch, RadioSet, OptionList, SelectCurrent, TextArea, Checkbox {
    border: round $line;
}

Input:focus, Switch:focus, RadioSet:focus, OptionList:focus, Select:focus > SelectCurrent, TextArea:focus, Checkbox:focus {
    border: round $line-focus;
}
