/* Dialogs are a gray panel over the terminal's background, so they stand apart from the chat.
   What sits inside them is transparent, so the panel shows through. */
$dialog-background: #333333;

Screen {
    layout: vertical;
}

#main {
    height: 1fr;
}

#chat {
    width: 1fr;
    padding: 0 1;
}

MemoryPanel {
    width: 40;
    border-left: solid ansi_bright_black;
    padding: 0 1;
}

MemoryPanel.hidden {
    display: none;
}

UserMessage {
    color: ansi_green;
    margin: 1 0 0 0;
}

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0 0 0 1;
    background: transparent;
    border-left: outer ansi_bright_black;
}

/* Markdown blocks keep a blank line below them; the reply's last one doesn't need it. */
AssistantMessage > MarkdownBlock:last-child {
    margin-bottom: 0;
}

AssistantMessage MarkdownParagraph, AssistantMessage MarkdownBullet, AssistantMessage MarkdownListItem {
    color: ansi_white;
}

TranscriptNote, ToolNote, StoppedNote {
    color: ansi_bright_black;
    padding: 0 0 0 2;
}

SystemNote {
    margin: 1 0 0 0;
    padding: 0 1;
    background: transparent;
    border: round ansi_bright_black;
}

ErrorMessage {
    color: ansi_red;
    margin: 1 0 0 0;
}

ToolCall {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
}

ThinkingNote {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    color: ansi_bright_black;
    text-style: italic;
}

ThinkingNote .thinking-text {
    padding: 0 0 0 2;
}

.follow-up-note {
    margin: 1 0 0 0;
    color: ansi_bright_black;
}

CarriedNote, BriefNote {
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    color: ansi_bright_black;
}

CarriedNote .carried-text, BriefNote .brief-text {
    padding: 0 0 0 2;
    background: transparent;
}

ToolCall .tool-result {
    color: ansi_bright_black;
    padding: 0 0 0 2;
}

ConnectionNote {
    height: 1;
    padding: 0 1;
    color: ansi_yellow;
}

StatusLine {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: ansi_bright_black;
}

CommandMenu {
    display: none;
    height: auto;
    max-height: 10;
    padding: 0 1;
    color: ansi_default;
}

.command-row {
    width: 100%;
    height: 1;
}

.command-row.highlighted {
    /* The color the memory panel headings ("Profile") show in the user's terminal. */
    background: #0078ab;
    color: #ffffff;
}

CommandMenu.visible {
    display: block;
}

#footer-row {
    dock: bottom;
    height: 1;
}

#footer-row Footer {
    dock: none;
    width: 1fr;
}

ContextFuel {
    width: auto;
    padding: 0 1;
}

MouseStatus {
    width: auto;
    padding: 0 1;
    color: ansi_bright_black;
}

#prompt-box {
    height: auto;
    border: round ansi_bright_black;
}

#prompt-box:focus-within {
    border: round #2f343f;
}

/* Inside the box's border, so the message box itself has none. */
#prompt, #prompt:focus {
    border: none;
    height: 1;
    width: 1fr;
}

AttachmentBar {
    display: none;
    width: auto;
    height: 1;
    padding-left: 1;
}

AttachmentBar.visible {
    display: block;
}

AttachmentBar .tag {
    width: auto;
    margin-right: 1;
    color: ansi_bright_black;
    text-style: bold;
}

ProfileScreen, WebSearchScreen, EmailScreen, EmailRecipientsScreen, ChannelSetupScreen, StartupScreen, McpAddScreen, McpSecretsScreen, ModelScreen, AudioScreen, SkillEditScreen {
    align: center middle;
}

#profile, #web-search, #email, #email-recipients, #home-section, #channel-setup-dialog, #startup, #host, #mcp-add, #mcp-secrets-dialog, #mcp-sign-in, #model, #audio, #skill-edit, #repository-install {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round ansi_bright_black;
    background: $dialog-background;
}

#profile Markdown, #web-search Markdown, #home-section Markdown, #email Markdown, #email-recipients Markdown, #channel-setup-dialog Markdown, #startup Markdown, #host Markdown, #mcp-add Markdown, #mcp-secrets-dialog Markdown, #mcp-sign-in Markdown, #model Markdown, #audio Markdown, #skill-edit Markdown, #repository-install Markdown {
    background: transparent;
    margin: 0;
}

/* Dialogs already have top padding; a heading's default top margin would add two more empty rows. */
ModalScreen Markdown > MarkdownHeader:first-child {
    margin-top: 0;
}

#profile-buttons, #web-search-buttons, #home-section-buttons, #email-buttons, #email-recipients-buttons, #channel-setup-buttons, #startup-buttons, #host-buttons, #mcp-add-buttons, #mcp-secrets-buttons, #mcp-sign-in-buttons, #model-buttons, #audio-buttons, #skill-edit-buttons, #repository-buttons {
    height: auto;
    margin-top: 1;
}

#profile-buttons Button, #web-search-buttons Button, #home-section-buttons Button, #email-buttons Button, #email-recipients-buttons Button, #channel-setup-buttons Button, #startup-buttons Button, #host-buttons Button, #mcp-add-buttons Button, #mcp-secrets-buttons Button, #mcp-sign-in-buttons Button, #model-buttons Button, #audio-buttons Button, #skill-edit-buttons Button, #repository-buttons Button {
    margin-right: 2;
}

/* Sending messages on from Chat, under the model in /model. */
#model-dispatch {
    height: auto;
    margin-top: 1;
}

#model-dispatch Label {
    padding: 1 1 0 0;
}

#model-dispatch Input {
    width: 24;
}

/* A channel's setup in /plugins, drawn from the items it sends. */
#plugin-setup, .channel-setup {
    height: auto;
}

.channel-setup Static {
    margin-bottom: 1;
}

.channel-setup .channel-heading {
    text-style: bold;
    margin-top: 1;
}

.channel-setup .channel-code {
    color: $accent;
}

.channel-setup .channel-qr {
    width: auto;
    height: auto;
}

.channel-setup .channel-copy {
    height: 8;
    border: round ansi_bright_black;
    background: transparent;
}

.channel-setup .channel-actions {
    height: auto;
    margin-bottom: 1;
}

.channel-setup .channel-actions Button {
    margin-right: 2;
}

ApprovalScreen {
    align: center middle;
}

#approval {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round ansi_yellow;
    background: $dialog-background;
}

#approval-command {
    margin: 1 0;
    padding: 0 1;
    background: transparent;
    color: ansi_yellow;
}

#approval-buttons {
    height: auto;
    margin-top: 1;
}

#approval-buttons Button {
    margin-right: 2;
}

QuestionScreen, PluginUpdatesScreen, AgentFolderScreen, SkillImportsScreen {
    align: center middle;
}

#question, #plugin-updates, #agent-folder, #repositories, #skill-imports {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round ansi_cyan;
    background: $dialog-background;
}

#question-options, #plugin-updates-list, #agent-folder-options, #repositories-list, #skill-imports-list {
    height: auto;
    max-height: 14;
    margin: 1 0;
}

#question-buttons, #plugin-updates-buttons, #agent-folder-buttons, #repositories-buttons, #skill-imports-buttons {
    height: auto;
}

#question-buttons Button, #plugin-updates-buttons Button, #repositories-buttons Button, #skill-imports-buttons Button {
    margin-right: 2;
}

SideConversationScreen {
    align: center middle;
}

#side-conversation {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round ansi_cyan;
    background: $dialog-background;
}

#side-conversation-brief {
    margin: 1 0;
}

#side-conversation-buttons {
    height: auto;
}

#side-conversation-buttons Button {
    margin-right: 2;
}

ConfirmScreen {
    align: center middle;
}

#confirm {
    width: 60%;
    max-width: 70;
    height: auto;
    padding: 1 2;
    border: round ansi_red;
    background: $dialog-background;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-right: 2;
}

Toast {
    background: ansi_default;
    color: ansi_default;
    border: round ansi_bright_black;
    padding: 0 1;
    max-width: 60;
}

Toast.-warning {
    border: round ansi_yellow;
}

Toast.-error {
    border: round ansi_red;
}

/* Markdown everywhere: default text color, dim structure, no colored inline code or headings. */
Markdown {
    color: ansi_default;
}

MarkdownH1, MarkdownH2, MarkdownH3 {
    content-align: left middle;
}

MarkdownBullet {
    color: ansi_bright_black;
}

Markdown MarkdownBlock > .code_inline {
    color: ansi_default !important;
    background: transparent !important;
    text-style: bold;
}

/* Buttons: gray outline, bold when focused; red text only for destructive actions. */
Button {
    background: transparent;
    color: ansi_default;
    border: round ansi_bright_black;
    text-style: none;
}

Button:focus {
    border: round ansi_default;
    text-style: bold;
}

Button:hover {
    background: transparent;
    border: round ansi_default;
}

Button.-success, Button.-primary {
    background: transparent;
    color: ansi_default;
}

Button.-error {
    background: transparent;
    color: ansi_red;
}

ModalScreen Input, ModalScreen OptionList, ModalScreen MarkdownHeader {
    background: transparent;
}

#profile Input, #profile SelectCurrent, #web-search Input, #home-section Input, #email Input, #email SelectCurrent, #mcp-add Input, #mcp-add SelectCurrent, #mcp-sign-in Input, #model Input, #model SelectCurrent, #audio SelectCurrent, #skill-edit Input, #repository-install Input {
    border: round ansi_bright_black;
    background: transparent;
}

#profile Input:focus, #web-search Input:focus, #home-section Input:focus, #email Input:focus, #mcp-add Input:focus, #mcp-sign-in Input:focus, #model Input:focus, #skill-edit Input:focus, #repository-install Input:focus {
    border: round #2f343f;
}

SkillsScreen, JobsScreen, ConversationsScreen, DevicesScreen, KeptKeysListScreen, HomeScreen, DoctorScreen, UsageScreen, SessionsScreen, McpScreen, LogsScreen, NotificationsScreen {
    align: center middle;
}

#skills, #jobs, #conversations, #devices, #keys, #home, #doctor, #files, #usage, #sessions, #mcp, #plugins, #logs, #notifications, #prompts {
    width: 90%;
    max-width: 120;
    height: 80%;
    padding: 1 2;
    border: round ansi_bright_black;
    background: $dialog-background;
}

#skills Markdown, #jobs Markdown, #conversations Markdown, #devices Markdown, #keys Markdown, #home Markdown, #doctor Markdown, #files Markdown, #usage Markdown, #sessions Markdown, #mcp Markdown, #plugins Markdown {
    background: transparent;
    margin: 0;
}

#skills-title, #jobs-title, #conversations-title, #devices-title, #keys-title, #home-title, #doctor-title, #files-title, #mcp-title, #plugins-title, #notifications-title, #prompts-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#skills-empty, #jobs-empty, #conversations-empty, #mcp-empty, #plugins-empty, #notifications-empty {
    display: none;
    height: auto;
}

#skills.empty, #jobs.empty, #conversations.empty, #mcp.empty, #plugins.empty, #notifications.empty {
    height: auto;
}

#skills.empty #skills-main, #jobs.empty #jobs-main, #conversations.empty #conversations-main, #mcp.empty #mcp-main, #plugins.empty #plugins-main, #notifications.empty #notifications-list {
    display: none;
}

#skills.empty #skills-empty, #jobs.empty #jobs-empty, #conversations.empty #conversations-empty, #mcp.empty #mcp-empty, #plugins.empty #plugins-empty, #notifications.empty #notifications-empty {
    display: block;
}

#skills-main, #jobs-main, #conversations-main, #devices-main, #keys-main, #home-main, #doctor-main, #files-main, #mcp-main, #usage-scroll, #plugins-main, #prompts-main {
    height: 1fr;
}

/* A short list: the dialog fits its content. */
#sessions {
    height: auto;
    max-height: 80%;
}

#sessions-scroll {
    height: auto;
}

#skills-list, #jobs-list, #conversations-list, #devices-list, #keys-list, #home-list, #doctor-list, #files-list, #plugins-list {
    width: 36;
    border: round ansi_bright_black;
    background: transparent;
}

/* Lists of short labels (dates, job and skill names) have no frame; a divider sets them apart from the
   detail next to them. */
#conversations-list, #jobs-list, #devices-list, #keys-list, #home-list, #doctor-list, #files-list, #skills-list, #mcp-list, #plugins-list, #prompts-list {
    border: none;
}

/* Each conversation's title over when it was last written in. */
#conversations-list {
    width: 36;
}

#notifications-list {
    height: 1fr;
    border: none;
    background: transparent;
}

#jobs-list, #devices-list, #keys-list, #home-list, #doctor-list, #files-list, #skills-list, #mcp-list, #plugins-list, #prompts-list {
    width: 32;
}

/* "Last active" is underlined across the preview, separating it from what was said. A Markdown
   rule would leave an empty line above itself. */
#conversation-body > MarkdownParagraph:first-of-type {
    border-bottom: solid ansi_bright_black;
}

#conversations-main .divider, #jobs-main .divider, #devices-main .divider, #keys-main .divider, #home-main .divider, #doctor-main .divider, #files-main .divider, #skills-main .divider, #mcp-main .divider, #plugins-main .divider, #prompts-main .divider {
    width: 1;
    height: 1fr;
    margin: 1 1 1 0;
    border-left: solid ansi_bright_black;
}

#skills-detail, #jobs-detail, #conversations-detail, #devices-detail, #keys-detail, #home-detail, #doctor-detail, #files-detail, #mcp-detail, #plugins-detail, #prompts-detail {
    padding: 0 1;
}

#skills-buttons, #jobs-buttons, #conversations-buttons, #devices-buttons, #keys-buttons, #home-buttons, #doctor-buttons, #files-buttons, #usage-buttons, #sessions-buttons, #mcp-buttons, #plugins-buttons, #notifications-buttons, #prompts-buttons {
    height: auto;
    margin-top: 1;
}

#skills-buttons Button, #jobs-buttons Button, #conversations-buttons Button, #devices-buttons Button, #keys-buttons Button, #home-buttons Button, #doctor-buttons Button, #usage-buttons Button, #mcp-buttons Button, #plugins-buttons Button, #notifications-buttons Button, #prompts-buttons Button {
    margin-right: 2;
}

/* Scrollbars in gray, like the rest of the structure. */
* {
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_white;
    scrollbar-color-active: ansi_white;
    scrollbar-background: ansi_default;
    scrollbar-background-hover: ansi_default;
    scrollbar-background-active: ansi_default;
    scrollbar-corner-color: ansi_default;
}

#mcp-tools, #mcp-add-tools, #repository-found {
    height: auto;
    max-height: 16;
    background: transparent;
}

#mcp-secrets, #mcp-secrets-text {
    height: 6;
}

#mcp-add, #repository-install {
    max-height: 90%;
}

#repository-fields {
    height: auto;
}

#audio {
    max-height: 90%;
}

#audio .audio-heading {
    text-style: bold;
    margin-top: 1;
}

#audio .audio-note {
    color: ansi_bright_black;
}

#audio-languages {
    height: auto;
    max-height: 10;
    background: transparent;
}

#save-stt, #save-replies {
    margin-top: 1;
}

#skill-edit-title {
    text-style: bold;
    margin-bottom: 1;
}

#skill-edit-instructions {
    height: 16;
}

#model-fields {
    height: auto;
}

#plugins-search {
    margin: 0 0 1 0;
}

#profile-items {
    height: auto;
    max-height: 12;
    margin: 1 0;
    border: round ansi_bright_black;
    background: transparent;
}

/* /logs: filters on top, the log in the middle, its controls below. */
#logs-filters, #logs-buttons {
    height: auto;
}

#logs-filters Select {
    width: 1fr;
    margin-right: 1;
}

#logs SelectCurrent {
    border: round ansi_bright_black;
    background: transparent;
}

#logs-title {
    height: auto;
    text-style: bold;
    margin: 1 0 0 0;
}

#logs-body {
    height: 1fr;
    background: transparent;
    border: round ansi_bright_black;
}

#logs-buttons {
    margin-top: 1;
}

#logs-buttons Button {
    margin-right: 2;
}

#logs-follow-label, #logs-record-label {
    height: 3;
    content-align: center middle;
    margin-right: 1;
}

#logs-follow {
    margin-right: 2;
}

#logs-record {
    width: 26;
    margin-right: 2;
}

/* What the text is for over the text, which takes the rest. */
#prompt-about {
    height: auto;
    margin-bottom: 1;
    color: ansi_bright_black;
}

#prompt-text {
    height: 1fr;
}

/* What a Home section shows: room for the assistant's instructions, then its plugins. */
#home-section-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#home-section-prompt {
    height: 8;
}

#home-section-note {
    height: auto;
    margin-top: 1;
}

#home-section-plugins {
    height: auto;
    max-height: 8;
    background: transparent;
}

/* Home's buttons are many: they keep closer together than other screens'. */
#home-buttons Button {
    margin-right: 1;
    min-width: 8;
}

/* How the built-in text changed since an edit: a few lines of diff above the editor. */
#prompt-changes {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    margin-bottom: 1;
    color: $warning;
}
