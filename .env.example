# The model can also be set from the app (/model, Settings → General → Model), which then
# overrides everything in this block.
ANTHROPIC_API_KEY=

# Provider: anthropic (default), openai, copilot or openrouter. With openai, set OPENAI_API_KEY
# and set MODEL / WORKER_MODEL to OpenAI model ids. With copilot (a GitHub Copilot
# subscription), set COPILOT_GITHUB_TOKEN and Copilot's model ids, e.g. claude-opus-5.5.
# With openrouter, set OPENROUTER_API_KEY (https://openrouter.ai/settings/keys) and
# OpenRouter's model ids, e.g. anthropic/claude-opus-5.5.
# PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # another OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
# COPILOT_GITHUB_TOKEN=
# OPENROUTER_API_KEY=

# Optional overrides
# MODEL=claude-opus-5-5
# WORKER_MODEL=claude-sonnet-5-5
# EFFORT=medium
# SERVER_FALLBACKS=true
# BASH_APPROVAL=dangerous  # always | dangerous | never
# TOOLSETS='["terminal","memory","web"]'

# Access from other hosts (browsers over the network). HTTPS with your certificate; every
# network request needs a device paired with /devices (terminal app) or Settings → Devices,
# or signed in with a passkey or a link emailed to you. Other names it's reached by (its
# certificate covering them too) go in HTTPS_OTHER_HOSTS.
# HTTPS_PORT=8443
# HTTPS_BIND=0.0.0.0
# HTTPS_HOST=assistant.example.com
# HTTPS_OTHER_HOSTS='["lo9i.local", "lo9i.example.ts.net"]'
# HTTPS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# HTTPS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# While no device was ever paired, the first browser pairs with the code in this file instead
# (an appliance writes the code on its label there; lo9i writes one when it's missing).
# SETUP_CODE_PATH=~/.lo9i/setup-code

# Web tools
# The Brave Search API key is set in the app (Settings → Integrations → Web search, /websearch).
# WEB_SEARCH_ENGINES=auto       # public engines used without a key, or when Brave fails
# WEB_BLOCKED_DOMAINS='["example.com"]'
# WEB_CACHE_MINUTES=20
# WEB_EXTRACT_MAX_CHARS=20000

# Epochs (compaction) and memory loading
# EPOCH_MAX_TOKENS=150000
# EPOCH_IDLE_HOURS=6
# EPOCH_KEEP_TURNS=4
# MEMORY_MAX_FACTS=200
# MEMORY_BASIC_FACTS_TOKENS=300
# MEMORY_RELEVANT_FACTS=5
# MEMORY_RELEVANT_SIMILARITY=0.835
# MEMORY_RELEVANT_CONVERSATIONS=3
# MEMORY_RELEVANT_CONVERSATIONS_SIMILARITY=0.83
# MEMORY_RELEVANT_CONVERSATIONS_MARGIN=0.05
# MEMORY_MAX_EPISODES=5
# TIMEZONE=UTC
# PERSONA_PATH=~/.lo9i/SOUL.md

# Speech to text
# STT_MODEL=small             # tiny | base | small | medium | large-v3-turbo
# STT_LANGUAGES='["es","en"]'
# STT_DECODING=accurate     # accurate (beam search, 5 candidates) | fast (greedy, about 2x faster)

# Telegram and Slack are plugins, installed and set up from inside the app, not here.

# Tracing is enabled when both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
