ANTHROPIC_API_KEY=

# Provider: anthropic (default) or openai. With openai, set OPENAI_API_KEY
# and set MODEL / WORKER_MODEL to OpenAI model ids.
# PROVIDER=anthropic
# OPENAI_API_KEY=

# Optional overrides
# MODEL=claude-opus-5-5
# WORKER_MODEL=claude-sonnet-5-5
# EFFORT=medium
# SERVER_FALLBACKS=true
# BASH_APPROVAL=dangerous  # always | dangerous | never
# TOOLSETS='["terminal","memory"]'

# Tracing is enabled when both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
