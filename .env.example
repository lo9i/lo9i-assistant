ANTHROPIC_API_KEY=

# Provider: anthropic (default) or openai. With openai, set OPENAI_API_KEY
# and set MODEL / WORKER_MODEL to OpenAI model ids.
# PROVIDER=anthropic
# OPENAI_API_KEY=

# Optional overrides
# MODEL=claude-opus-5-5
# WORKER_MODEL=claude-sonnet-5-5
# EFFORT=medium
# SERVER_FALLBACKS=true
# BASH_APPROVAL=dangerous  # always | dangerous | never
# TOOLSETS='["terminal","memory","web"]'

# Web tools
# WEB_SEARCH_BACKEND=searxng   # searxng | brave | duckduckgo
# WEB_SEARCH_FALLBACK=duckduckgo   # searxng | brave | duckduckgo | none
# BRAVE_SEARCH_API_KEY=         # https://brave.com/search/api/
# WEB_BLOCKED_DOMAINS='["example.com"]'
# WEB_CACHE_MINUTES=20
# WEB_EXTRACT_MAX_CHARS=20000
# SEARXNG_SECRET=change-me

# Epochs (compaction) and memory loading
# EPOCH_MAX_TOKENS=150000
# EPOCH_IDLE_HOURS=6
# EPOCH_KEEP_TURNS=4
# MEMORY_MAX_FACTS=200
# MEMORY_MAX_EPISODES=5
# TIMEZONE=UTC
# PERSONA_PATH=~/.lo9i/SOUL.md

# Telegram gateway (create a bot with @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS='[123456789]'

# Tracing is enabled when both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
