{
  "name": "lo9i-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run api:types && npm run check && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "api": "cd .. && UPDATE_OPENAPI=1 uv run pytest tests/daemon/test_api.py -q -k schema_matches && cd web && npm run api:types",
    "api:types": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.49.0",
    "cronstrue": "^3.27.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  }
}
