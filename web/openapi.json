    "/events": {
      "get": {
        "summary": "Events",
        "description": "Everything that changes while no run is open: memory, skills, jobs, integrations, runs\nstarted from other channels. Clients keep this open for their whole session, so it also\ntells which clients are connected. A new connection starts from now; a reconnection sends\nthe last id it received and gets what it missed.",
        "operationId": "events_events_get",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
